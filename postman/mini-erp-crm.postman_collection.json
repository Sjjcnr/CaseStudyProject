{
  "info": {
    "_postman_id": "a9b8c7d6-e5f4-4321-8765-123456789abc",
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Complete Postman API Collection for Mini ERP + CRM Portal covering Auth, Customer CRM, Products & Inventory, and Sales Challans.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
